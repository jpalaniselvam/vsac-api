{
  "name": "vsac-api",
  "version": "1.0.0",
  "description": "CLI and SDK for interacting with Value Set Authority Center (VSAC) APIs.",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:e2e": "vitest run e2e",
    "test:e2e:watch": "vitest watch e2e",
    "test:e2e:ui": "vitest --ui e2e",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Jeyamurugan Palaniselvam",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/ui": "^4.0.14",
    "dotenv": "^17.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.2"
  }
}